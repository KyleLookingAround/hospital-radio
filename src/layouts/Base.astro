---
/**
 * The shared shell: head (meta/OG/JSON-LD), the mobile top strip, the tuner
 * (nav + lamp + player), the page, the sign-off footer. Every page renders
 * inside this. The old hash-route shim is kept so shared links still work.
 */
import '../styles/index.css';
import { getBand, getShows, getSongs, getGallery, getMusic, jsonLd, station as getStation } from '../lib/site';
import { lampState, songStats, daysSince } from '../lib/stats';
import Tuner from '../components/Tuner.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** which station this page is, e.g. "shows" */
  station?: string;
  /** the page's file name, e.g. "shows.html" — empty for the home page */
  page?: string;
  bodyClass?: string;
}

const SITE_URL = 'https://hospitalradiofullstop.co.uk/';
const band = await getBand();
const music = await getMusic();
const { upcoming, past } = await getShows();
const songs = await getSongs();
const photos = await getGallery();

const {
  title = 'Hospital Radio. — Manchester midwest emo',
  description = 'Hospital Radio. — a midwest emo transmission from Manchester. Shows, the log, songs, photos, merch.',
  station = 'index',
  page = '',
  bodyClass,
} = Astro.props;

const pageUrl = SITE_URL + page;
const st = getStation(station);
const lamp = lampState(upcoming);
const songCount = songStats(past, songs.map((s) => s.title)).length;
const last = past[0];
const meta: Record<string, string> = {
  index: 'the booth',
  shows: upcoming.length ? `${upcoming.length} scheduled` : (last ? `nothing booked · ${daysSince(last.date)} days of dead air` : 'nothing booked'),
  archive: `${past.length} logged`,
  lyrics: `${songCount} songs · ${songs.length} with words`,
  listen: `${music.releases.length} releases`,
  photos: `${photos.length} photos`,
  booking: 'patient file · hr-877',
};
const radioOn = band.radio.enabled && band.radio.embedUrl;
const nowPlaying = music.releases[0] ? `${music.releases[0].title} · ${[music.releases[0].type, music.releases[0].year].filter(Boolean).join(' ')}` : '';
---

<!doctype html>
<html lang="en" style={`--freq:${st.freq}`} data-station={st.id} data-static={band.intro.enabled ? 'on' : 'off'}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#1D2E63">
<meta name="color-scheme" content="dark">
<link rel="canonical" href={pageUrl}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={band.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={`${SITE_URL}assets/og-image.jpg`}>
<meta property="og:image:secure_url" content={`${SITE_URL}assets/og-image.jpg`}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={title}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${SITE_URL}assets/og-image.jpg`}>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2316224A'/%3E%3Ccircle cx='16' cy='17' r='6' fill='%23DF8090'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href="/assets/fonts/fraunces-300-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/ibmplexmono-500.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd(band, upcoming, SITE_URL)).replace(/</g, '\\u003c')} />
<!-- old links used hash routes (/#/shows) — send them to the real pages -->
<script is:inline>
(function () {
  var h = location.hash;
  if (!h || h.indexOf('#/') !== 0) return;
  var p = h.slice(2).replace(/\/+$/, '');
  if (!p) { location.replace('/'); return; }
  location.replace('/' + p + '.html');
})();
</script>
</head>
<body class={bodyClass}>
<a class="skip" href="#main">skip to content</a>

<header class="topstrip">
  <a class="brand wordmark" href="/" aria-label="Hospital Radio. home">hospital <span>radio</span><i>.</i></a>
  <span class="lamp" data-state={lamp}><span>{lamp === 'standby' ? 'standby' : lamp === 'live' ? 'live tonight' : 'on air'}</span></span>
</header>

<Tuner stationId={st.id} lamp={lamp} meta={meta} spotify={band.links.spotify} embedUrl={radioOn ? band.radio.embedUrl : ''} embedHeight={band.radio.height} frequency={band.radio.frequency} nowPlaying={nowPlaying} />

<main id="main">
<slot />
</main>

<Footer />

<!-- hidden sink so the subscribe form posts without navigating away -->
<iframe name="tuneSink" title="subscribe" hidden aria-hidden="true"></iframe>

<script src="../scripts/app.ts"></script>
</body>
</html>
