---
/**
 * The shared shell: head (meta/OG/JSON-LD), the mobile top strip, the tuner
 * (nav + lamp + player), the page, the sign-off footer. Every page renders
 * inside this. The old hash-route shim is kept so shared links still work.
 */
import '../styles/index.css';
import { getBand, getShows, jsonLd, station as getStation } from '../lib/site';
import { lampState } from '../lib/stats';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** which station this page is, e.g. "shows" */
  station?: string;
  /** the page's file name, e.g. "shows.html" — empty for the home page */
  page?: string;
  bodyClass?: string;
}

const SITE_URL = 'https://hospitalradiofullstop.co.uk/';
const band = await getBand();
const { upcoming } = await getShows();

const {
  title = 'Hospital Radio. — Manchester midwest emo',
  description = 'Hospital Radio. — a midwest emo transmission from Manchester. Shows, the log, songs, photos, merch.',
  station = 'index',
  page = '',
  bodyClass,
} = Astro.props;

const pageUrl = SITE_URL + page;
const st = getStation(station);
const lamp = lampState(upcoming);
const radioOn = band.radio.enabled && band.radio.embedUrl;
---

<!doctype html>
<html lang="en" data-station={st.id}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#F5E9D7">
<meta name="color-scheme" content="light">
<link rel="canonical" href={pageUrl}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={band.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={`${SITE_URL}assets/og-image.jpg`}>
<meta property="og:image:secure_url" content={`${SITE_URL}assets/og-image.jpg`}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={title}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${SITE_URL}assets/og-image.jpg`}>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23F5E9D7'/%3E%3Ccircle cx='16' cy='17' r='6' fill='%23DF8090'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href="/assets/fonts/fraunces-300-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/ibmplexmono-500.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd(band, upcoming, SITE_URL)).replace(/</g, '\\u003c')} />
<!-- old links used hash routes (/#/shows) — send them to the real pages -->
<script is:inline>
(function () {
  var h = location.hash;
  if (!h || h.indexOf('#/') !== 0) return;
  var p = h.slice(2).replace(/\/+$/, '');
  if (!p) { location.replace('/'); return; }
  location.replace('/' + p + '.html');
})();
</script>
</head>
<body class={bodyClass}>
<a class="skip" href="#main">skip to content</a>

<Header stationId={st.id} lamp={lamp} spotify={band.links.spotify} embedUrl={radioOn ? band.radio.embedUrl : ''} embedHeight={band.radio.height} merch={band.links.merch} />

<main id="main">
<slot />
</main>

<Footer />

<!-- hidden sink so the subscribe form posts without navigating away -->
<iframe name="tuneSink" title="subscribe" hidden aria-hidden="true"></iframe>

<script src="../scripts/app.ts"></script>
</body>
</html>
