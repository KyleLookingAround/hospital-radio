---
/**
 * The shared shell: head, a one-line header, the page, a plain footer.
 * Nothing else. Every page renders inside this.
 */
import '../styles/site.css';
import { getBand, getShows, socialList, jsonLd } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** the page's file name, e.g. "shows.html" — empty for the home page */
  page?: string;
  /** which nav link is current: shows | lyrics | photos | booking */
  nav?: string;
}

const SITE_URL = 'https://hospitalradiofullstop.co.uk/';
const band = await getBand();
const { upcoming } = await getShows();
const {
  title = 'Hospital Radio. — Manchester midwest emo',
  description = 'Hospital Radio. are a midwest emo four-piece from Manchester. Listen, shows, lyrics and merch.',
  page = '',
  nav = '',
} = Astro.props;

const links: [string, string, string][] = [
  ['shows', '/shows.html', 'Shows'],
  ['lyrics', '/lyrics.html', 'Lyrics'],
  ['photos', '/photos.html', 'Photos'],
  ['booking', '/booking.html', 'Booking'],
];
const socials = socialList(band.links).filter(([n]) => n !== 'Merch');
const pageUrl = SITE_URL + page;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#F5E9D7">
<link rel="canonical" href={pageUrl}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={band.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={`${SITE_URL}assets/og-image.jpg`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={`${SITE_URL}assets/og-image.jpg`}>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23F5E9D7'/%3E%3Ccircle cx='16' cy='17' r='6' fill='%23DF8090'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href="/assets/fonts/fraunces-300-900.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd(band, upcoming, SITE_URL)).replace(/</g, '\\u003c')} />
<!-- old links used hash routes (/#/shows) — send them to the real pages -->
<script is:inline>
(function () {
  var h = location.hash;
  if (!h || h.indexOf('#/') !== 0) return;
  var p = h.slice(2).replace(/\/+$/, '');
  if (!p) { location.replace('/'); return; }
  location.replace('/' + p + '.html');
})();
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-head">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="Hospital Radio. home">hospital <span>radio.</span></a>
    <nav class="nav" aria-label="Main">
      {links.map(([id, href, label]) => <a href={href} aria-current={nav === id ? 'page' : undefined}>{label}</a>)}
      {band.links.merch && <a href={band.links.merch} target="_blank" rel="noopener">Merch ↗</a>}
    </nav>
  </div>
</header>

<main id="main">
<slot />
</main>

<footer class="site-foot">
  <div class="wrap">
    <nav class="foot-links" aria-label="Footer">
      <a href="/">Home</a>
      {links.map(([, href, label]) => <a href={href}>{label}</a>)}
      {band.links.merch && <a href={band.links.merch} target="_blank" rel="noopener">Merch ↗</a>}
    </nav>
    {socials.length > 0 && (
      <ul class="socials" aria-label="Elsewhere">
        {socials.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n}</a></li>)}
      </ul>
    )}
    <p class="copy">© {new Date().getFullYear()} Hospital Radio. · {band.tagline}</p>
  </div>
</footer>

<script src="../scripts/site.ts"></script>
</body>
</html>
