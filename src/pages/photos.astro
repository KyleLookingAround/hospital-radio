---
/**
 * Photos, grouped by venue (the captions in content/gallery.yml), in colour.
 * Every tile links to a :target lightbox at the end of the page, so it
 * works with JavaScript off; src/scripts/lightbox.ts adds keys and swipe.
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Picture from '../components/Picture.astro';
import { getBand, getGallery, getShows } from '../lib/site';
import { galleryGroups, venueStats } from '../lib/stats';
import { findImage } from '../lib/images';

const band = await getBand();
const photos = await getGallery();
const { past } = await getShows();
const groups = galleryGroups(photos, band.name);
const venues = venueStats(past);
const total = photos.length;
const credits = Array.from(new Set(photos.map((p) => (p.credit || '').replace(/^📷\s*/, '').trim()).filter(Boolean)));
const meta = [`${total} photos`, groups.length > 1 ? `${groups.length} rooms` : '', credits.length ? `📷 ${credits.join(', ')}` : ''].filter(Boolean).join(' · ');
const orient = (src: string) => { const m = findImage(src); return m ? (m.width > m.height ? 'landscape' : m.width < m.height ? 'portrait' : 'square') : 'square'; };
const playedAt = (title: string) => venues.find((v) => v.venue.toLowerCase() === title.toLowerCase() || v.venue.toLowerCase().startsWith(title.toLowerCase()));
const capOf = (p: { caption?: string; credit?: string }) => [p.caption, p.credit].filter(Boolean).join(' · ');
---

<Base title="Photos · Hospital Radio." description={`${total} photos of Hospital Radio. live and off duty.`} station="photos" page="photos.html" bodyClass="photos-page">

<PageHead kicker="photos" title="From the <em>booth</em>" meta={meta} />

<section class="wrap section" id="gallery">
  {groups.length === 0 && <p class="quiet">no photos yet — add image files and list them in the gallery config.</p>}
  {groups.map((g) => { const v = playedAt(g.title); return (
    <div class="darkroom-group">
      <h2 class="group-label"><span>{g.promo ? 'promo' : g.title}</span><small>{g.photos.length} {g.photos.length === 1 ? 'photo' : 'photos'}{v ? ` · played here ${v.count}×` : ''}</small></h2>
      <div class="photos">
        {g.photos.map((p) => (
          <a class:list={['ph', orient(p.src)]} href={`#p${p.index}`} aria-label={`Open photo ${p.index + 1}: ${p.caption || band.name}`}>
            <Picture src={p.src} alt="" widths={[480, 800]} sizes="(min-width:1100px) 25vw, (min-width:720px) 33vw, 50vw" />
            {capOf(p) && <span class="cap">{capOf(p)}</span>}
          </a>
        ))}
      </div>
    </div>
  ); })}
  <p class="quiet" style="margin-top:8px">tap a photo to enlarge · <a class="link" href="/archive.html">the log has the dates</a></p>
</section>

{photos.map((p, i) => (
  <div class="lb" id={`p${i}`} role="dialog" aria-label={`Photo ${i + 1} of ${total}`}>
    <div class="lb-top"><span><b>{i + 1}</b> / {total}</span><a class="btn" href="#gallery">close ✕</a></div>
    <div class="lb-img"><Picture src={p.src} alt={p.caption || band.name} widths={[1200, 1600]} sizes="100vw" /></div>
    <div class="lb-nav">
      <a class="btn" href={`#p${(i - 1 + total) % total}`} aria-label="Previous photo">‹</a>
      <span class="cap">{capOf(p)}</span>
      <a class="btn" href={`#p${(i + 1) % total}`} aria-label="Next photo">›</a>
    </div>
  </div>
))}

</Base>
