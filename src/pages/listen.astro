---
/**
 * Listen: the bio as a pull-quote, every platform, the releases (with how
 * often each has been played live), other videos, and a pointer to the chart.
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import LedgerLine from '../components/LedgerLine.astro';
import { getBand, getMusic, getShows, getSongs, socialList, slug } from '../lib/site';
import { songStats, shortDate, displayTitle } from '../lib/stats';

const band = await getBand();
const music = await getMusic();
const { past } = await getShows();
const songs = await getSongs();
const stats = songStats(past, songs.map((s) => s.title));
const statFor = (title: string) => stats.find((s) => s.slug === slug(title));
const plats = socialList(band.links).filter(([n]) => ['Spotify', 'Apple Music', 'YouTube', 'SoundCloud'].includes(n));
const releases = music.releases;
const metaBits = [releases.length ? `${releases.length} ${releases.length === 1 ? 'release' : 'releases'}` : '', music.videos.length ? `${music.videos.length} ${music.videos.length === 1 ? 'video' : 'videos'}` : '', plats.length ? `${plats.length} platforms` : ''].filter(Boolean).join(' · ');
const top = stats.slice(0, 3);
---

<Base title="Listen · Hospital Radio." description="Hospital Radio. on every platform — releases, music videos and where to stream." station="listen" page="listen.html" bodyClass="listen-page">

<PageHead kicker="on every platform" title="Listen <em>in</em>" meta={metaBits} />

<section class="wrap section listen-intro">
  {band.bio && <blockquote class="pull">{band.bio}</blockquote>}
  {band.members.length > 0 && <p class="mono dim members">{band.members.join(' · ')}</p>}
  {plats.length > 0 && (
    <ul class="presets" aria-label="Platforms">
      {plats.map(([n, u], i) => (
        <li><a class="preset" href={u} target="_blank" rel="noopener"><span class="p">{String(i + 1).padStart(2, '0')}</span><span class="nm">{n}</span><span class="go">open ↗</span></a></li>
      ))}
    </ul>
  )}
</section>

{releases.length > 0 && (
  <section class="wrap section" id="releases">
    <div class="sec-head"><h2 class="h2">Releases</h2></div>
    <div class="vid-grid">
      {releases.map((r) => { const s = statFor(r.title); return (
        <VideoPlayer title={r.title} url={r.url} type={r.type} year={r.year} sub={s && s.firstPlayed ? `in the set since ${shortDate(s.firstPlayed)} · played live ${s.plays}×` : ''} />
      ); })}
    </div>
  </section>
)}

{music.videos.length > 0 && (
  <section class="wrap section" id="videos">
    <div class="sec-head"><h2 class="h2">More <em>videos</em></h2></div>
    <div class="vid-grid">
      {music.videos.map((v) => <VideoPlayer title={v.title} url={v.url} />)}
    </div>
  </section>
)}

{top.length > 0 && (
  <section class="wrap section">
    <div class="sheet ledger slip">
      <div class="kicker">the chart</div>
      <h2 class="h3" style="margin-top:10px">Every song we’ve played live is on the <em>chart</em></h2>
      <div class="ledger" style="margin-top:14px">
        {top.map((s, i) => <LedgerLine label={displayTitle(s.title)} href={`/lyrics/${s.slug}.html`}>№ {String(i + 1).padStart(2, '0')} · <b>{s.plays}</b> plays</LedgerLine>)}
      </div>
      {stats.length > top.length && <p class="quiet" style="margin-top:10px">{stats.length - top.length} more in the set</p>}
      <p class="home-links" style="margin-top:12px"><a class="btn text" href="/lyrics.html">the full chart →</a><a class="btn text" href="/request.html">request a song →</a></p>
    </div>
  </section>
)}

</Base>
