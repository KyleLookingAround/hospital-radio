---
/**
 * Home: the mascot, one line in the band's hand, who they are, a way to
 * listen, the videos, the next show (or an honest note), the merch.
 */
import Site from '../layouts/Site.astro';
import Picture from '../components/Picture.astro';
import Video from '../components/Video.astro';
import { getBand, getMusic, getShows, getSongs, socialList, slug, DOW, MON } from '../lib/site';

const band = await getBand();
const music = await getMusic();
const { upcoming, past } = await getShows();
const songs = await getSongs();

const lyricSlugs = new Set(songs.map((s) => s.slug));
const next = upcoming.slice(0, 3);
const last = past[0];
const platforms = socialList(band.links).filter(([n]) => ['Apple Music', 'YouTube', 'SoundCloud'].includes(n));
const thisYear = new Date().getFullYear();
const day = (d: Date) => `${DOW[d.getDay()][0]}${DOW[d.getDay()].slice(1).toLowerCase()} ${d.getDate()} ${MON[d.getMonth()][0]}${MON[d.getMonth()].slice(1).toLowerCase()}${d.getFullYear() === thisYear ? '' : ` ${d.getFullYear()}`}`;
---

<Site page="">

<section class="hero wrap">
  <h1>
    {band.logoImage
      ? <Picture src={band.logoImage} alt={band.name} widths={[300, 600]} sizes="(min-width: 760px) 300px, 62vw" loading="eager" fetchpriority="high" />
      : <span class="wordmark">hospital <span>radio.</span></span>}
  </h1>
  {band.scrawl && <p class="scrawl">{band.scrawl}</p>}
  {band.bio && <p class="lede">{band.bio}</p>}
  {band.links.spotify && <a class="btn" href={band.links.spotify} target="_blank" rel="noopener">Listen on Spotify</a>}
  {platforms.length > 0 && (
    <p class="small">Also on {platforms.map(([n, u], i) => <>{i > 0 && ' · '}<a href={u} target="_blank" rel="noopener">{n}</a></>)}</p>
  )}
</section>

{music.releases.length > 0 && (
  <section class="section wrap" id="music">
    <h2>Music</h2>
    <div class="videos">
      {music.releases.map((r) => (
        <Video title={r.title} url={r.url} meta={[r.type, r.year].filter(Boolean).join(' · ')}>
          {lyricSlugs.has(slug(r.title)) && <a href={`/lyrics/${slug(r.title)}.html`}>Lyrics</a>}
        </Video>
      ))}
    </div>
    {music.videos.length > 0 && (
      <p class="small more">Also: {music.videos.map((v, i) => <>{i > 0 && ' · '}<a href={v.url} target="_blank" rel="noopener">{v.title}</a></>)}</p>
    )}
  </section>
)}

<section class="section wrap" id="shows">
  <h2>Shows</h2>
  {next.length > 0 && (
    <ul class="gigs" data-upcoming>
      {next.map((s) => (
        <li class="show" data-date={s.date}>
          <span class="gig-date">{day(s._d)}</span>
          <span><span class="gig-venue">{s.venue}</span><span class="gig-city">{[s.city, s.with].filter(Boolean).join(' · ')}</span></span>
          <span class="gig-act">{s.soldOut ? 'Sold out' : s.tickets ? <a href={s.tickets} target="_blank" rel="noopener">Tickets ↗</a> : 'Info soon'}</span>
        </li>
      ))}
    </ul>
  )}
  <div class="quiet-note" data-empty-fallback hidden={next.length > 0}>
    <p>No shows booked right now.</p>
    {band.status && <p>{band.status}</p>}
    {last && <p class="small">Last played {day(last._d)} at {last.venue}{last.city ? `, ${last.city}` : ''}.</p>}
  </div>
  <p class="small more"><a href="/shows.html">{next.length > 0 ? 'All shows' : 'Past shows'}</a></p>
</section>

{music.merchItems.length > 0 && (
  <section class="section wrap" id="merch">
    <h2>Merch</h2>
    <ul class="merch read">
      {music.merchItems.slice(0, 4).map((m) => (
        <li><a href={m.url} target="_blank" rel="noopener"><span>{m.name}</span><span class="price">{m.price}</span></a></li>
      ))}
    </ul>
    {band.links.merch && <p class="small more"><a href={band.links.merch} target="_blank" rel="noopener">Full store ↗</a></p>}
  </section>
)}

{band.mailingList.action && (
  <section class="section wrap" id="list">
    <h2>Mailing list</h2>
    <p class="read">New songs and show dates, straight to your inbox.</p>
    <form class="tune-form read" id="tuneForm" action={band.mailingList.action} method="post" target="tuneSink" data-connected="1" novalidate>
      <label class="visually-hidden" for="tuneEmail">Email address</label>
      <input type="email" name={band.mailingList.fieldName || 'email'} id="tuneEmail" placeholder="you@example.com" autocomplete="email" required>
      <button class="btn" type="submit">Subscribe</button>
    </form>
    <p class="tune-msg small" id="tuneMsg" role="status"></p>
    <iframe name="tuneSink" title="subscribe" hidden></iframe>
  </section>
)}

</Site>
