---
/**
 * 88.9 FM — one page per song: the union of lyric files and every song in a
 * logged setlist. Lyric titles win over setlist spelling. Ordered by chart rank.
 */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Sheet from '../../components/Sheet.astro';
import Tally from '../../components/Tally.astro';
import Stamp from '../../components/Stamp.astro';
import LedgerLine from '../../components/LedgerLine.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import PunchCard from '../../components/PunchCard.astro';
import { getSongs, getShows, renderLyrics } from '../../lib/site';
import { songStats, loggedShows, longestRun, displayTitle, shortDate, type SongStat } from '../../lib/stats';

type SongDoc = { title: string; slug: string; lyrics?: string; listen?: string; type?: string; year?: string };
type Neighbour = { slug: string; title: string; rank: number } | null;

export async function getStaticPaths() {
  const songs = await getSongs();
  const { past } = await getShows();
  const stats = songStats(past, songs.map((s) => s.title));
  const entries: { slug: string; song: SongDoc; stat?: SongStat }[] = stats.map((st) => {
    const doc = songs.find((s) => s.slug === st.slug);
    return { slug: st.slug, stat: st, song: doc ? { title: doc.title, slug: doc.slug, lyrics: doc.lyrics, listen: doc.listen, type: doc.type, year: doc.year } : { title: st.title, slug: st.slug } };
  });
  for (const s of songs) if (!entries.some((e) => e.slug === s.slug)) {
    entries.push({ slug: s.slug, song: { title: s.title, slug: s.slug, lyrics: s.lyrics, listen: s.listen, type: s.type, year: s.year } });
  }
  const nb = (e: typeof entries[number] | undefined, rank: number): Neighbour => (e ? { slug: e.slug, title: displayTitle(e.song.title), rank } : null);
  return entries.map((e, i) => ({
    params: { slug: e.slug },
    props: { song: e.song, stat: e.stat, rank: i + 1, total: entries.length, prev: nb(entries[i - 1], i), next: nb(entries[i + 1], i + 2) },
  }));
}

const { song, stat, rank, total, prev, next } = Astro.props as { song: SongDoc; stat?: SongStat; rank: number; total: number; prev: Neighbour; next: Neighbour };
const { past } = await getShows();
const logged = loggedShows(past);
const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

const title = displayTitle(song.title);
const coverNote = (song.title.match(/\(([^)]*)\)/)?.[1] || '').toLowerCase();
const titleHtml = title.endsWith('.') ? `${esc(title.slice(0, -1))}<span class="dot">.</span>` : `${esc(title)}<span class="dot">.</span>`;
const plays = stat?.plays ?? 0;
const kicker = `${(song.type || 'song').toLowerCase()}${song.year ? ' · ' + song.year : ''}`;
const metaBits = plays
  ? [`played live <b>${plays}×</b>`, `opened <b>${stat!.opened}</b>`, `closed <b>${stat!.closed}</b>`]
  : ['not played live yet'];
const meta = metaBits.join(' · ');
const run = stat ? longestRun(stat, past) : 0;
const cities = stat ? [...new Set(stat.shows.map((s) => s.city).filter(Boolean))] : [];
const heard = stat ? [...stat.shows].reverse() : [];
const words = song.lyrics ? renderLyrics(song.lyrics) : '';
const lineCount = song.lyrics ? song.lyrics.split('\n').filter((l) => l.trim()).length : 0;
const chorusCount = (words.match(/class="verse chorus"/g) || []).length;
const sub = stat?.firstPlayed ? `in the set since ${shortDate(stat.firstPlayed)} · played live ${plays}×` : '';
const pageTitle = `${title} · the words · Hospital Radio.`;
const description = song.lyrics
  ? `Lyrics to ‘${title}’ by Hospital Radio.${plays ? ` — played live ${plays} times.` : ''}`
  : `‘${title}’ by Hospital Radio. — played live ${plays} times. Words not filed yet.`;
---

<Base title={pageTitle} description={description} station="lyrics" page={`lyrics/${song.slug}.html`} bodyClass="songpage">

<PageHead kicker={kicker} title={titleHtml} meta={meta} back={{ href: '/lyrics.html', label: 'the chart' }}>
  <div class="head-row">
    {plays > 0 && <Tally n={plays} />}
    {plays > 0 && <span class="sticker" style="--rot:-4">№ {String(rank).padStart(2, '0')} on the chart</span>}
    {coverNote && <Stamp kind="cover" text={coverNote} class="pink" />}
  </div>
</PageHead>

<section class="wrap section" aria-label="The words">
  {song.lyrics ? (
    <Sheet width="read" tilt={-0.4} class="words-sheet">
      <span class="tape tl" aria-hidden="true"></span>
      <div class="sheet-head">
        <div class="kicker">the words</div>
        <span class="mono dim">{lineCount} lines{chorusCount ? ` · chorus ×${chorusCount}` : ''}</span>
      </div>
      <div class="words" set:html={words} />
      <div class="words-foot">
        <span class="scrawl">as sung — give or take</span>
        {song.listen && !song.listen.includes('yout') && <a class="btn text" href={song.listen} target="_blank" rel="noopener">listen ↗</a>}
      </div>
    </Sheet>
  ) : (
    <Sheet width="read" tilt={0.4} class="nowords-sheet slip">
      <span class="tape tr" aria-hidden="true"></span>
      <div class="kicker">the words</div>
      <p class="scrawl big">no words filed yet</p>
      <p class="quiet">the words will be filed here when the band types them up{plays ? ` · until then the punch card below is the record` : ''}</p>
      {song.listen && <p class="actions" style="margin-top:14px"><a class="btn" href={song.listen} target="_blank" rel="noopener">listen ↗</a></p>}
    </Sheet>
  )}

  {song.listen && (
    <div class="video-wrap">
      <VideoPlayer title={title} url={song.listen} type={song.type || ''} year={song.year || ''} sub={sub} />
    </div>
  )}
</section>

<section class="wrap section" aria-labelledby="punch-h">
  <div class="panel punch-panel">
    <div class="punch-head">
      <div><div class="kicker">the punch card</div><h2 class="h2" id="punch-h">Clocked <em>in</em></h2></div>
      <span class="mono readout">{plays ? <><b>{plays}</b> of <b>{logged.length}</b> logged sets</> : <>0 of {logged.length} logged sets</>}</span>
    </div>
    {logged.length ? (
      <>
        <PunchCard stat={stat} shows={logged} />
        <div class="punch-key" aria-hidden="true"><span class="k-on">in the set</span><span class="k-open">opened</span><span class="k-close">closed</span><span>not played</span></div>
        <p class="quiet punch-hint">one square per logged set, oldest first · tap a square for that night in the log</p>
      </>
    ) : <p class="quiet">no setlists logged yet.</p>}
  </div>
</section>

<section class="wrap section two-up facts-row" aria-label="The facts">
  <Sheet width="full" tilt={0.3} class="facts-sheet">
    <div class="kicker">the facts</div>
    <div class="ledger">
      <LedgerLine label="played live"><b class={plays ? 'marker' : undefined}>{plays}×</b></LedgerLine>
      <LedgerLine label="chart position">{plays ? `№ ${String(rank).padStart(2, '0')} of ${total}` : 'unranked'}</LedgerLine>
      <LedgerLine label="first played" href={stat?.firstPlayed ? `/archive.html#show-${stat.firstPlayed}` : undefined}>{stat?.firstPlayed ? shortDate(stat.firstPlayed) : '—'}</LedgerLine>
      <LedgerLine label="last played" href={stat?.lastPlayed ? `/archive.html#show-${stat.lastPlayed}` : undefined}>{stat?.lastPlayed ? shortDate(stat.lastPlayed) : '—'}</LedgerLine>
      <LedgerLine label="opened the set"><b>{stat?.opened ?? 0}×</b></LedgerLine>
      <LedgerLine label="closed the set"><b>{stat?.closed ?? 0}×</b></LedgerLine>
      <LedgerLine label="longest run">{run ? `${run} ${run === 1 ? 'show' : 'shows'} in a row` : '—'}</LedgerLine>
      <LedgerLine label="cities">{cities.length ? cities.map((c) => c.toLowerCase()).join(' · ') : '—'}</LedgerLine>
      {song.year && <LedgerLine label="released">{[song.type || 'single', song.year].join(' · ').toLowerCase()}</LedgerLine>}
    </div>
  </Sheet>

  <div class="heard-block">
    <div class="sec-head">
      <h2 class="h2">Heard <em>at</em></h2>
      <span class="page-meta">{heard.length} {heard.length === 1 ? 'night' : 'nights'} · newest first</span>
    </div>
    {heard.length ? (
      <ol class="heard">
        {heard.map((s) => (
          <li><a href={`/archive.html#show-${s.date}`}>
            <span class="d mono">{shortDate(s.date)}</span>
            <span class="v">{s.venue}{s.city && <small>, {s.city}</small>}</span>
            <span class="p mono" aria-label={`song ${s.position} of ${s.of}`}>{s.position}/{s.of}</span>
          </a></li>
        ))}
      </ol>
    ) : <p class="quiet">not on any logged running order yet — <a class="link" href="/request.html">ask for it on the request line</a>.</p>}
  </div>
</section>

{(prev || next) && (
  <nav class="wrap section song-nav" aria-label="Chart neighbours">
    {prev ? <a class="prev" href={`/lyrics/${prev.slug}.html`}><span class="d">◂ № {String(prev.rank).padStart(2, '0')}</span><span class="t">{prev.title}</span></a> : <span></span>}
    {next ? <a class="next" href={`/lyrics/${next.slug}.html`}><span class="d">№ {String(next.rank).padStart(2, '0')} ▸</span><span class="t">{next.title}</span></a> : <span></span>}
  </nav>
)}

</Base>
