---
/**
 * The tuner: the site's navigation, status lamp, clock, frequency readout,
 * power switch and the booth monitor (player), rendered once. Sticky top bar
 * on desktop; fixed bottom bar on phones (thumb reach) where the station
 * list opens as a DIAL sheet. Everything works with JavaScript off.
 */
import { STATIONS, station as getStation } from '../lib/site';
import type { LampState } from '../lib/stats';
interface Props { stationId: string; lamp: LampState; meta: Record<string, string>; spotify: string; embedUrl: string; embedHeight: number; frequency: string; nowPlaying?: string; programmeName: string; hasVideo: boolean }
const { stationId, lamp, meta, spotify, embedUrl, embedHeight, frequency, nowPlaying, programmeName, hasVideo } = Astro.props;
const cur = getStation(stationId);
const lampWord: Record<LampState, string> = { standby: 'standby', scheduled: 'on air', live: 'live tonight' };
const name = (id: string, label: string) => id === 'index' ? 'the booth' : id === 'shows' ? 'the schedule' : id === 'photos' ? 'the darkroom' : id === 'booking' ? 'for promoters' : id === 'request' ? 'request line' : label;
const hasTray = !!(embedUrl || hasVideo);
---
<nav class="tuner" aria-label="Stations">
  <div class="tuner-bar">
    <a class="brand wordmark" href="/" aria-label="Hospital Radio. home">hospital <span>radio</span><i>.</i></a>
    <span class="lamp" data-state={lamp} id="lamp"><span id="lampWord">{lampWord[lamp]}</span></span>
    <span class="onnow label" aria-label="On air now"><span data-clock></span> <b data-programme-name>{programmeName}</b></span>
    <span class="readout" aria-label={`Tuned to ${cur.freq} FM`}><b data-readout>{cur.freq}</b><small>FM</small></span>

    <div class="ruler">
      <ul>
        {STATIONS.map((s) => (
          <li style={`--f:${s.freq}`}><a href={s.href} data-station-link={s.freq} aria-current={s.id === stationId ? 'page' : undefined}>{s.label}</a></li>
        ))}
      </ul>
      <span class="needle" aria-hidden="true"></span>
    </div>

    <details class="dial" id="dial">
      <summary aria-label="Open the station list">dial</summary>
      <div class="dial-sheet">
        <div class="dial-head"><span class="label">87.7 fm · the dial</span><span class="label dim">tap a ward</span></div>
        {STATIONS.map((s) => (
          <a class="dial-row sign" href={s.href} aria-current={s.id === stationId ? 'page' : undefined}>
            <span class="f">{s.freq}</span><span class="n">{name(s.id, s.label)}</span><span class="arrow" aria-hidden="true">→</span>
            {meta[s.id] && <span class="m">{meta[s.id]}</span>}
          </a>
        ))}
      </div>
    </details>

    <button class="pwr" type="button" data-power aria-pressed="false" title="Radio sound on/off"><span class="sw" aria-hidden="true"></span><span class="t">pwr</span></button>

    {hasTray ? (
      <button class="tunein" id="tunein" type="button" aria-expanded="false" aria-controls="tray"><span class="ring"></span><span class="t">monitor</span></button>
    ) : (
      spotify && <a class="tunein" href={spotify} target="_blank" rel="noopener"><span class="ring"></span><span class="t">listen</span></a>
    )}
  </div>

  {hasTray && (
    <div class="tray" id="tray" hidden data-embed={embedUrl}>
      <div class="tray-head">
        <b>● {frequency} fm</b>
        <span class="now">on the monitor · <i>{nowPlaying || 'hospital radio.'}</i></span>
        <button class="tray-close" type="button" id="trayClose" aria-label="Close the monitor">✕</button>
      </div>
      {hasVideo && (
        <div class="tray-monitor">
          <div class="tray-video"><div id="monitor-player"></div><p class="tray-hint mono">flick <b>pwr</b> and tune to {frequency} to hear the band through the booth monitor</p></div>
        </div>
      )}
      {embedUrl && (
        <details class="tray-spotify">
          <summary class="mono">open the spotify player ▸</summary>
          <iframe id="radioFrame" title="Hospital Radio on Spotify" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" style={`height:${embedHeight}px`}></iframe>
        </details>
      )}
      <div class="tray-foot">dead air never sounded so good</div>
    </div>
  )}
  {hasTray && spotify && <noscript><a class="tunein tunein-nojs" href={spotify}>open in spotify</a></noscript>}
</nav>
