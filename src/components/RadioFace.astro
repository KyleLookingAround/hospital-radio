---
/**
 * The radio face — the home page is a radio you tune. A big frequency band
 * with the stations on it, a knob, the readout, a power switch, a signal
 * meter, and the fragments of other stations that bleed in as you turn.
 * Without JavaScript it is a hero with a working list of station links.
 */
import { STATIONS, BAND, type Station } from '../lib/site';
import Picture from './Picture.astro';
interface Props { hero: string; tagline: string; frequency: string; founded: string; programmeName: string; programmeStrap: string }
const { hero, tagline, frequency, founded, programmeName, programmeStrap } = Astro.props;
const ticks = Array.from({ length: Math.round((BAND.max - BAND.min) / 0.1) + 1 }, (_, i) => +(BAND.min + i * 0.1).toFixed(1));
const posOf = (f: number) => ((f - BAND.min) / (BAND.max - BAND.min)) * 100;
const name = (s: Station) => s.id === 'index' ? 'the booth' : s.id === 'request' ? 'requests' : s.label;
---
<section class="face" aria-label="Hospital Radio 87.7 FM">
  <div class="face-bg riso" aria-hidden="true">
    {hero && <Picture class="riso-img" src={hero} alt="" widths={[800, 1200, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={62} />}
    {hero && <Picture class="riso-ghost" src={hero} alt="" widths={[800, 1200]} sizes="100vw" loading="eager" quality={40} />}
  </div>
  <div class="wrap face-grid">
    <div class="face-top">
      <p class="label onair-line"><span class="lampdot" aria-hidden="true"></span> on air · <span data-clock>now</span> · <b data-programme-name>{programmeName}</b></p>
      <p class="label dim strap" data-programme-strap>{programmeStrap}</p>
    </div>

    <h1 class="wordmark hero-word">hospital <span>radio</span><i>.</i></h1>
    <p class="label hero-tag">{tagline} · {frequency} fm · est. {founded}</p>

    <div class="instrument" id="instrument">
      <div class="band-wrap">
        <div class="band" data-band aria-hidden="true">
          <div class="ticks">
            {ticks.map((t) => <i style={`left:${posOf(t)}%`} class:list={{ major: Number.isInteger(t), station: STATIONS.some((s) => +s.freq === t) }} data-n={Number.isInteger(t) ? t.toFixed(0) : undefined}></i>)}
          </div>
          <span class="band-needle"></span>
        </div>
        <ul class="band-stations">
          {STATIONS.map((s) => (
            <li style={`--p:${posOf(+s.freq)}%`}>
              <a href={s.href} data-station-link={s.freq} aria-current={s.id === 'index' ? 'page' : undefined}><b>{s.freq}</b><span>{name(s)}</span></a>
            </li>
          ))}
        </ul>
      </div>

      <div class="controls">
        <div class="knob" data-knob role="slider" tabindex="0" aria-label="Tuning dial" aria-valuemin={BAND.min} aria-valuemax={BAND.max} aria-valuenow={frequency} aria-valuetext={`${frequency} FM, the booth`} aria-describedby="knob-help">
          <span class="knob-face"><span class="knob-mark"></span></span>
        </div>
        <div class="readout-big" aria-live="off">
          <span class="rb-freq"><b data-readout>{frequency}</b><small>fm</small></span>
          <span class="rb-word mono" data-signal-word>the booth · locked</span>
          <span class="meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
        <button class="power" type="button" data-power aria-pressed="false"><span class="sw" aria-hidden="true"></span><span class="pw-t">power</span><span class="pw-s mono">sound on/off</span></button>
      </div>
      <p class="knob-help mono" id="knob-help">turn the dial · drag the band · arrow keys · let go on a station to retune</p>
      <p class="fragment mono" data-fragment aria-live="polite"></p>
    </div>
  </div>
</section>
