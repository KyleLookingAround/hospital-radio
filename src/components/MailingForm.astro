---
/** "join the broadcast" — inert (with a friendly note) until a provider URL is set in content/band.yml. */
import { getBand } from '../lib/site';
import Sheet from './Sheet.astro';
const band = await getBand();
const m = band.mailingList;
const on = !!m.action;
---
<section class="wrap section">
  <Sheet width="ledger" class="slip">
    <div class="kicker">join the broadcast</div>
    <h2 class="h2" style="margin-top:12px">Tune <em>in</em>.</h2>
    <p style="margin-top:12px;max-width:52ch">New singles, show announcements and the occasional transmission from the booth — straight to your inbox. No noise, just the signal.</p>
    <form class="tune-form" id="tuneForm" action={on ? m.action : undefined} method={on ? 'post' : undefined} target={on ? 'tuneSink' : undefined} data-connected={on ? '1' : '0'} novalidate>
      <label class="visually-hidden" for="tuneEmail">Email address</label>
      <input type="email" name={m.fieldName || 'email'} id="tuneEmail" placeholder="you@example.com" autocomplete="email" required disabled={!on}>
      <button class="btn solid" type="submit" disabled={!on}>Subscribe</button>
    </form>
    <div class={`tune-msg ${on ? '' : 'note'}`} id="tuneMsg" role="status">{on ? '' : "Mailing list isn't connected yet — drop your provider's form URL into the config to switch it on."}</div>
  </Sheet>
</section>
